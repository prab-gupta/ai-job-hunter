          "required": ["url", "company", "role", "cv", "letter"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "dedupe_check",
        "description": "Checks if a job application already exists in the ledger.",
        "parameters": {
          "type": "object",
          "properties": {
            "company": {
              "type": "string",
              "description": "The name of the company."
            },
            "url": {
              "type": "string",
              "description": "The URL of the job posting."
            }
          },
          "required": ["company", "url"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "compile_latex",
        "description": "Compiles bespoke LaTeX CV and Cover Letter.",
        "parameters": {
          "type": "object",
          "properties": {
            "cv_path": {
              "type": "string",
              "description": "The path to the tailored LaTeX CV file."
            },
            "letter_path": {
              "type": "string",
              "description": "The path to the tailored LaTeX Cover Letter file."
            }
          },
          "required": ["cv_path", "letter_path"]
        }
      }
    },
    {
