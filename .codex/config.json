{
  "name": "ai-job-hunter",
  "version": "1.0.0",
  "description": "OpenAI Codex configuration for Autonomous AI Job Hunter",
  "entrypoint": "CODEX.md",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "apply_workable",
        "description": "Submits an application via Workable.",
        "parameters": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "description": "The URL of the Workable job posting."
            },
            "company": {
              "type": "string",
              "description": "The name of the company."
            },
            "role": {
              "type": "string",
              "description": "The job role/title."
            },
            "cv": {
              "type": "string",
              "description": "The path to the compiled CV PDF."
            },
            "letter": {
              "type": "string",
              "description": "The path to the compiled Cover Letter PDF."
            }
          },
          "required": ["url", "company", "role", "cv", "letter"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "apply_personio",
